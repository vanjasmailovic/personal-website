---
import { siteConfig } from '../config/site';
---

<section
  class="section-block contact-section"
  id="contact"
  data-nav-section
  data-section-id="contact"
  aria-labelledby="contact-title"
  tabindex="-1"
>
  <div class="site-shell contact-layout">
    <p class="section-kicker">Contact and CV</p>

    <div class="contact-details">
      <div class="document-links" aria-label="Professional documents">
        <a
          class="document-link"
          href="/documents/vanja-smailovic-cv-583041272076.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>View{' '}<span class="text-accent">CV</span></span>
          <small>PDF · opens in a new tab</small>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="document-link"
          href="/documents/vanja-smailovic-portfolio-d360efbf29b1.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>View{' '}<span class="text-accent">Portfolio</span></span>
          <small>PDF · opens in a new tab</small>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="document-link"
          href={siteConfig.linkedIn}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>View{' '}<span class="text-accent">LinkedIn Profile</span></span>
          <small>Profile · opens in a new tab</small>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="contact-heading">
      <h2 class="section-title" id="contact-title">
        Have an AI or ML product problem worth solving?
      </h2>
      <p class="section-intro">
        If you are evaluating an AI or ML opportunity, unblocking a product, or looking for hands-on
        technical leadership, email is the simplest place to start.
      </p>
      <a class="contact-email" href={`mailto:${siteConfig.email}`}>
        <span class="text-accent">{siteConfig.email}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: clamp(5rem, 10vw, 9rem);
    background: var(--color-panel-strong);
    color: var(--color-paper);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    column-gap: clamp(3rem, 9vw, 9rem);
    row-gap: 0;
  }

  .contact-heading {
    grid-column: 1;
    grid-row: 2;
  }

  .contact-details {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .contact-section :global(.section-kicker) {
    grid-column: 1;
    color: var(--color-muted);
  }

  .section-title {
    max-width: 13ch;
  }

  .section-intro {
    color: var(--color-muted);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.5rem;
    color: var(--color-paper);
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    font-weight: 500;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35rem;
  }

  .document-links {
    display: grid;
    gap: 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .document-link {
    display: grid;
    min-height: 5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-paper);
    text-decoration: none;
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }

  .document-link:hover {
    background: transparent;
    color: var(--color-accent);
    transform: translateX(0.2rem);
  }

  .document-link > span:first-child {
    font-weight: 500;
  }

  .document-link > span:last-child {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-size: 1.25rem;
  }

  .document-link small {
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0;
  }

  @media (max-width: 64rem) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-heading,
    .contact-details {
      grid-column: 1;
      grid-row: auto;
    }

    .contact-heading {
      margin-top: 3rem;
    }

    .document-links {
      margin-top: 0;
    }
  }

  @media (max-width: 28rem) {
    .contact-email {
      font-size: 0.95rem;
    }
  }
</style>
