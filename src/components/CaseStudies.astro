---
import { getCollection } from 'astro:content';

import CaseStudyCard from './CaseStudyCard.astro';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<section
  class="section-block case-studies"
  id="case-studies"
  data-nav-section
  aria-labelledby="case-studies-title"
  tabindex="-1"
>
  <div class="site-shell">
    <div class="case-studies-heading">
      <p class="section-kicker">Case studies</p>
      <h2 class="section-title" id="case-studies-title">
        Seven products, each grounded in a real operating problem.
      </h2>
    </div>

    <div class="case-study-list">
      {studies.map((study) => <CaseStudyCard study={study} />)}
    </div>
  </div>
</section>

<script>
  const stabilizeCaseStudyAccordions = (): void => {
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>(
      '[data-case-study] details',
    );

    detailsElements.forEach((details) => {
      const summary = details.querySelector('summary');
      if (!summary) return;

      summary.addEventListener('click', () => {
        if (details.open) return;

        const scrollLeft = window.scrollX;
        const scrollTop = window.scrollY;

        window.requestAnimationFrame(() => {
          window.scrollTo(scrollLeft, scrollTop);
        });
      });
    });
  };

  const revealCaseStudy = (): void => {
    const hash = window.location.hash;
    if (!hash) return;

    const target = document.getElementById(hash.slice(1));
    if (!target?.matches('[data-case-study]')) return;

    const details = target.querySelector('details');
    if (details instanceof HTMLDetailsElement) details.open = true;
  };

  stabilizeCaseStudyAccordions();
  revealCaseStudy();
  window.addEventListener('hashchange', revealCaseStudy);
</script>

<style>
  .case-studies {
    background: #090d11;
  }

  .case-studies-heading {
    display: grid;
    gap: 0;
  }

  .case-study-list {
    display: grid;
    gap: 0.65rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    overflow-anchor: none;
  }
</style>
