---
import { getCollection } from 'astro:content';

import CaseStudyCard from './CaseStudyCard.astro';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<section
  class="section-block case-studies"
  id="case-studies"
  data-nav-section
  aria-labelledby="case-studies-title"
  tabindex="-1"
>
  <div class="site-shell">
    <div class="case-studies-heading">
      <h2 class="section-title" id="case-studies-title">Case Studies</h2>
      <p class="section-intro">Seven products, each grounded in a real operating problem.</p>
    </div>

    <div class="case-study-list">
      {studies.map((study) => <CaseStudyCard study={study} />)}
    </div>
  </div>
</section>

<script>
  const stabilizeCaseStudyAccordions = (): void => {
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>(
      '[data-case-study] details',
    );

    const collapseDetails = (details: HTMLDetailsElement, reduceMotion: boolean): void => {
      if (!details.open) return;

      const content = details.querySelector<HTMLElement>('.case-expanded');
      if (!content || reduceMotion) {
        details.open = false;
        return;
      }

      content.getAnimations().forEach((animation) => animation.cancel());
      details.dataset.animating = 'true';

      const animation = content.animate(
        [
          { height: `${content.scrollHeight}px`, opacity: 1, overflow: 'hidden' },
          { height: '0px', opacity: 0, overflow: 'hidden' },
        ],
        { duration: 180, easing: 'ease-out', fill: 'forwards' },
      );

      animation.addEventListener('finish', () => {
        details.open = false;
        animation.cancel();
        delete details.dataset.animating;
      });
      animation.addEventListener('cancel', () => delete details.dataset.animating);
    };

    detailsElements.forEach((details) => {
      const summary = details.querySelector('summary');
      const content = details.querySelector<HTMLElement>('.case-expanded');
      if (!summary || !content || details.dataset.accordionReady === 'true') return;

      details.dataset.accordionReady = 'true';

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (details.dataset.animating === 'true') return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (details.open) {
          collapseDetails(details, reduceMotion);
          return;
        }

        detailsElements.forEach((otherDetails) => {
          if (otherDetails !== details) collapseDetails(otherDetails, reduceMotion);
        });

        if (reduceMotion) {
          details.open = true;
          return;
        }

        details.dataset.animating = 'true';
        details.open = true;

        const animation = content.animate(
          [
            { height: '0px', opacity: 0, overflow: 'hidden' },
            { height: `${content.scrollHeight}px`, opacity: 1, overflow: 'hidden' },
          ],
          { duration: 180, easing: 'ease-out' },
        );

        animation.addEventListener('finish', () => delete details.dataset.animating);
        animation.addEventListener('cancel', () => delete details.dataset.animating);
      });
    });
  };

  const revealCaseStudy = (): void => {
    const hash = window.location.hash;
    if (!hash) return;

    const target = document.getElementById(hash.slice(1));
    if (!target?.matches('[data-case-study]')) return;

    const details = target.querySelector('details');
    if (!(details instanceof HTMLDetailsElement)) return;

    document.querySelectorAll<HTMLDetailsElement>('[data-case-study] details').forEach((item) => {
      item.open = item === details;
    });
  };

  stabilizeCaseStudyAccordions();
  revealCaseStudy();
  window.addEventListener('hashchange', revealCaseStudy);
</script>

<style>
  .case-studies {
    background: var(--color-ink);
  }

  .case-studies-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: start;
    gap: 3rem;
  }

  .case-studies-heading .section-intro {
    margin: 0;
  }

  .case-study-list {
    display: grid;
    gap: 0;
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    overflow-anchor: none;
  }

  @media (max-width: 48rem) {
    .case-studies-heading {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }
  }
</style>
