---
import type { CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
---

<article class="case-study-card" id={study.data.anchor} data-case-study tabindex="-1">
  <details>
    <summary>
      <span class="case-title" role="heading" aria-level="3">{study.data.title}</span>
      <span class="summary-icon" aria-hidden="true"></span>
    </summary>

    <div class="case-expanded">
      <div class="case-facts">
        <section aria-labelledby={`${study.data.anchor}-problem`}>
          <h4 id={`${study.data.anchor}-problem`}>Problem</h4>
          <p>{study.data.problem}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-built`}>
          <h4 id={`${study.data.anchor}-built`}>Built</h4>
          <p>{study.data.built}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-technology`}>
          <h4 id={`${study.data.anchor}-technology`}>Tech</h4>
          <ul>
            {study.data.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </section>
        <section class="case-outcome" aria-labelledby={`${study.data.anchor}-outcome`}>
          <h4 id={`${study.data.anchor}-outcome`}>Outcome</h4>
          <p>{study.data.outcome}</p>
        </section>
      </div>
    </div>
  </details>
</article>

<style>
  .case-study-card {
    border-bottom: 1px solid var(--color-line);
    background: transparent;
  }

  .case-study-card:target {
    border-color: var(--color-muted);
  }

  .case-study-card:hover,
  .case-study-card:has(details[open]) {
    background: transparent;
  }

  summary {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 0;
    color: var(--color-paper);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    border-bottom: 0;
  }

  .case-title {
    font-size: clamp(1.15rem, 2.1vw, 1.65rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .summary-icon,
  .summary-icon::after {
    display: block;
    flex: 0 0 auto;
    width: 1rem;
    height: 1px;
    background: var(--color-muted);
    content: '';
    transition: transform 150ms ease;
  }

  .summary-icon::after {
    transform: rotate(90deg);
  }

  details[open] .summary-icon::after {
    transform: rotate(0deg);
  }

  .case-expanded {
    padding: 0 0 clamp(2.5rem, 5vw, 4rem);
    background: transparent;
  }

  .case-facts {
    max-width: 52rem;
  }

  .case-facts section {
    display: grid;
    grid-template-columns: minmax(6rem, 0.24fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: 0.8rem;
  }

  .case-facts .case-outcome {
    margin-top: 1.35rem;
    padding-top: 2.15rem;
    border-top: 1px solid var(--color-line);
  }

  h4 {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 450;
    letter-spacing: 0;
    line-height: 1.6;
  }

  .case-facts p {
    margin: 0;
    color: #c5ced8;
  }

  .case-facts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .case-facts li {
    padding: 0.32rem 0.72rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    color: #c5ced8;
    font-size: 0.78rem;
    line-height: 1.3;
  }

  @media (max-width: 44rem) {
    summary {
      min-height: 4.5rem;
      gap: 1rem;
    }

    .case-facts section {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
