---
import type { CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  index: number;
}

const { study, index } = Astro.props;

const outcomeAccents = [
  '~6 weeks',
  '2.5 hours saved',
  '24x reduction',
  'natural-language access',
  'expert-level payments insights',
  '20 active B2B customers',
  'more than 5 million credit decisions',
  '150 live customers',
  '13 markets',
  'savings of €800k+',
  'higher-potential opportunities',
  'organization-wide',
];

const accentOutcome = (outcome: string) => {
  const matches = outcomeAccents
    .map((text) => ({ text, start: outcome.indexOf(text) }))
    .filter(({ start }) => start >= 0)
    .sort((a, b) => a.start - b.start);

  if (!matches.length) return [{ text: outcome, accented: false }];

  const segments: { text: string; accented: boolean }[] = [];
  let cursor = 0;

  matches.forEach(({ text, start }) => {
    if (start > cursor) segments.push({ text: outcome.slice(cursor, start), accented: false });
    segments.push({ text, accented: true });
    cursor = start + text.length;
  });

  if (cursor < outcome.length) segments.push({ text: outcome.slice(cursor), accented: false });

  return segments;
};

const outcomeSegments = accentOutcome(study.data.outcome);
---

<article class="case-study-card" id={study.data.anchor} data-case-study tabindex="-1">
  <details>
    <summary>
      <span class="item-number case-number" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <span class="case-title" role="heading" aria-level="3">{study.data.title}</span>
      <span class="summary-icon" aria-hidden="true"></span>
    </summary>

    <div class="case-expanded">
      <div class="case-facts">
        <section aria-labelledby={`${study.data.anchor}-problem`}>
          <h4 id={`${study.data.anchor}-problem`}>Problem</h4>
          <p>{study.data.problem}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-built`}>
          <h4 id={`${study.data.anchor}-built`}>Built</h4>
          <p>{study.data.built}</p>
        </section>
        <section class="case-outcome" aria-labelledby={`${study.data.anchor}-outcome`}>
          <h4 id={`${study.data.anchor}-outcome`}>Outcome</h4>
          <p>
            {
              outcomeSegments.map((segment) => (
                <span class:list={{ 'outcome-accent': segment.accented }}>{segment.text}</span>
              ))
            }
          </p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-technology`}>
          <h4 id={`${study.data.anchor}-technology`}>Tech</h4>
          <ul>
            {study.data.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </details>
</article>

<style>
  .case-study-card {
    border-bottom: 1px solid var(--color-line);
    background: transparent;
  }

  .case-study-card:target {
    border-color: var(--color-muted);
  }

  .case-study-card:hover,
  .case-study-card:has(details[open]) {
    background: transparent;
  }

  summary {
    display: grid;
    min-height: 6rem;
    grid-template-columns: clamp(4.5rem, 8vw, 6.5rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: 1rem 0;
    color: var(--color-paper);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    border-bottom: 0;
  }

  .case-title {
    font-size: clamp(1.15rem, 2.1vw, 1.65rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .case-number {
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
  }

  .summary-icon,
  .summary-icon::after {
    display: block;
    flex: 0 0 auto;
    width: 1rem;
    height: 1px;
    background: var(--color-muted);
    content: '';
    transition: transform 150ms ease;
  }

  .summary-icon::after {
    transform: rotate(90deg);
  }

  details[open] .summary-icon::after {
    transform: rotate(0deg);
  }

  .case-expanded {
    padding: 0 0 clamp(2rem, 5vw, 2.5rem);
    background: transparent;
  }

  .case-facts {
    width: 100%;
    padding-left: calc(clamp(4.5rem, 8vw, 6.5rem) + clamp(1.25rem, 3vw, 2.5rem));
  }

  .case-facts section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    align-items: start;
    padding-block: 0.8rem;
  }

  .case-facts section:first-child {
    padding-top: 1.2rem;
  }

  h4 {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 450;
    letter-spacing: 0;
    line-height: 1.6;
  }

  .case-facts p {
    margin: 0;
    color: #c5ced8;
  }

  .case-facts :global(.outcome-accent) {
    color: var(--color-accent);
  }

  .case-facts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .case-facts li {
    padding: 0.32rem 0.72rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    color: #c5ced8;
    font-size: 0.78rem;
    line-height: 1.3;
  }

  @media (max-width: 44rem) {
    summary {
      min-height: 4.5rem;
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .case-number {
      font-size: 2.35rem;
    }

    .case-facts {
      padding-left: 4.25rem;
    }
  }
</style>
