---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<article class="case-study-card" id={study.data.anchor} data-case-study tabindex="-1">
  <details>
    <summary>
      <span class="case-title" role="heading" aria-level="3">{study.data.title}</span>
      <span class="summary-icon" aria-hidden="true"></span>
    </summary>

    <div class="case-expanded">
      <div class="case-intro">
        <p class="case-category">{study.data.category}</p>
        <p class="case-summary">{study.data.summary}</p>
      </div>

      <div class="case-facts">
        <section aria-labelledby={`${study.data.anchor}-problem`}>
          <h4 id={`${study.data.anchor}-problem`}>Problem</h4>
          <p>{study.data.problem}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-built`}>
          <h4 id={`${study.data.anchor}-built`}>Built</h4>
          <p>{study.data.built}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-outcome`}>
          <h4 id={`${study.data.anchor}-outcome`}>Outcome</h4>
          <p>{study.data.outcome}</p>
        </section>
        <section aria-labelledby={`${study.data.anchor}-technology`}>
          <h4 id={`${study.data.anchor}-technology`}>Technology</h4>
          <ul>
            {study.data.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </section>
      </div>

      <div class="case-narrative">
        <Content />
      </div>
    </div>
  </details>
</article>

<style>
  .case-study-card {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .case-study-card:target {
    border-color: var(--color-accent);
  }

  .case-study-card:hover,
  .case-study-card:has(details[open]) {
    background: var(--color-panel-strong);
  }

  summary {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem clamp(1.25rem, 3vw, 2.25rem);
    color: var(--color-paper);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    border-bottom: 1px solid var(--color-line);
  }

  .case-title {
    font-size: clamp(1.15rem, 2.1vw, 1.65rem);
    font-weight: 580;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .summary-icon,
  .summary-icon::after {
    display: block;
    flex: 0 0 auto;
    width: 1rem;
    height: 1px;
    background: var(--color-accent);
    content: '';
    transition: transform 150ms ease;
  }

  .summary-icon::after {
    transform: rotate(90deg);
  }

  details[open] .summary-icon::after {
    transform: rotate(0deg);
  }

  .case-expanded {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: var(--color-ink);
  }

  .case-intro {
    display: grid;
    grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .case-category {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-summary {
    max-width: 42rem;
    margin: 0;
    color: #d6dcde;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .case-facts section {
    min-height: 12rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  h4,
  .case-narrative :global(h4) {
    margin: 0;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-facts p,
  .case-narrative :global(p) {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
  }

  .case-facts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .case-facts li {
    padding: 0.32rem 0.5rem;
    border: 1px solid var(--color-line);
    color: #c8d0d3;
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .case-narrative {
    max-width: 52rem;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .case-narrative :global(h4:not(:first-child)) {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 44rem) {
    summary {
      min-height: 4.5rem;
      gap: 1rem;
    }

    .case-intro,
    .case-facts {
      grid-template-columns: 1fr;
    }

    .case-intro {
      gap: 0.75rem;
    }

    .case-facts section {
      min-height: 0;
    }
  }
</style>
