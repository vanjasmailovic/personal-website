---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
---

<section class="hero site-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-kicker">
      Lead AI Engineer <span aria-hidden="true">/</span> Applied AI Consultant
    </p>
    <h1 id="hero-title">
      <span>AI products that perform.</span>
      <span>Cut complexity.</span>
      <span>Deliver measurable impact.</span>
    </h1>
    <p class="hero-intro">
      I help product and engineering leaders turn ambiguous AI opportunities into shipped
      capabilities — from executive assistants and document automation to analytics agents, anomaly
      detection and risk models.
    </p>
    <p class="hero-proof">
      Hands-on engineering, product development and technical leadership shaped by 15+ years across
      startups, scale-ups and enterprise teams.
    </p>
    <div class="hero-actions">
      <a class="button-link" href="#case-studies">
        View case studies
        <span aria-hidden="true">↘</span>
      </a>
      <a class="button-link secondary" href="#contact">Start a conversation</a>
    </div>
  </div>

  <figure class="portrait-frame">
    <div class="portrait-meta" aria-hidden="true">
      <span>Stockholm, SE</span>
      <span>01 / 01</span>
    </div>
    <Image
      src={avatar}
      alt="Vanja Smailovic"
      widths={[420, 640, 900]}
      sizes="(max-width: 767px) 92vw, (max-width: 1199px) 44vw, 31rem"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
    <figcaption>
      <span class="status-dot" aria-hidden="true"></span>
      Based in the Stockholm area, Sweden
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - 4.75rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7.5rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 540;
    letter-spacing: -0.065em;
    line-height: 0.91;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  h1 span + span {
    margin-top: 0.14em;
  }

  .hero-intro {
    max-width: 43rem;
    margin: 2rem 0 0;
    color: #c8d0d3;
    font-size: clamp(1.12rem, 2vw, 1.38rem);
    line-height: 1.55;
  }

  .hero-proof {
    max-width: 39rem;
    padding-left: 1rem;
    margin: 1.5rem 0 0;
    border-left: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.98rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .portrait-frame {
    position: relative;
    align-self: center;
    padding: 0.65rem;
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .portrait-frame::before,
  .portrait-frame::after {
    position: absolute;
    z-index: 2;
    width: 2rem;
    height: 2rem;
    pointer-events: none;
    content: '';
  }

  .portrait-frame::before {
    top: -1px;
    left: -1px;
    border-top: 1px solid var(--color-accent);
    border-left: 1px solid var(--color-accent);
  }

  .portrait-frame::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
  }

  .portrait-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.2rem 0.1rem 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 0.1rem 0.15rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.2rem rgb(126 217 183 / 12%);
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 4rem;
      padding-block: 4.5rem 5.5rem;
    }

    .portrait-frame {
      width: min(100%, 34rem);
    }
  }

  @media (max-width: 36rem) {
    h1 {
      font-size: clamp(2.75rem, 14vw, 4.3rem);
    }

    .hero-actions,
    .button-link {
      width: 100%;
    }
  }
</style>
