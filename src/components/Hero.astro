---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
---

<section class="hero site-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-kicker">
      <span class="text-accent">Lead AI Engineer</span>
      <span aria-hidden="true">·</span>
      <span class="text-accent">Applied AI Consultant</span>
    </p>
    <h1 id="hero-title">
      <span>AI products that perform.</span>
      <span class="text-accent hero-strike">Cut complexity.</span>
      <span>Deliver measurable impact.</span>
    </h1>
    <p class="hero-proof">
      Hi, I'm Vanja. I help product and engineering leaders turn ambiguous AI opportunities into
      shipped capabilities — from executive assistants and document automation to analytics agents,
      anomaly detection and risk models. I bring hands-on engineering, product development and
      technical leadership shaped by 15+ years across startups, scale-ups and enterprise teams.
    </p>
    <div class="hero-actions">
      <a class="button-link" href="#case-studies">
        View case studies
        <span aria-hidden="true">↘</span>
      </a>
      <a class="button-link secondary" href="#contact">Start a conversation</a>
    </div>
  </div>

  <figure class="portrait-frame">
    <Image
      src={avatar}
      alt="Vanja Smailovic"
      widths={[420, 640, 900]}
      sizes="(max-width: 767px) 92vw, (max-width: 1199px) 44vw, 31rem"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    min-height: calc(100svh - 5rem);
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.65fr);
    align-items: center;
    gap: clamp(4rem, 9vw, 8rem);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 450;
    letter-spacing: 0;
    line-height: 1.4;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3rem, 6.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.052em;
    line-height: 0.96;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  h1 span + span {
    margin-top: 0.14em;
  }

  .hero-strike {
    text-decoration-line: line-through;
    text-decoration-thickness: 0.07em;
  }

  .hero-proof {
    max-width: 39rem;
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: 0.98rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .hero > .portrait-frame {
    align-self: center;
    justify-self: end;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-paper) 14%, transparent);
    border-radius: 50%;
  }

  .portrait-frame :global(img.portrait) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    filter: grayscale(1) contrast(0.96);
    object-fit: cover;
    object-position: center 36%;
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 4rem;
      padding-block: 4.5rem 5.5rem;
    }

    .hero > .portrait-frame {
      justify-self: center;
      width: min(72vw, 22rem);
    }
  }

  @media (max-width: 36rem) {
    h1 {
      font-size: clamp(2.75rem, 14vw, 4.3rem);
    }

    .hero-actions,
    .button-link {
      width: 100%;
    }
  }
</style>
