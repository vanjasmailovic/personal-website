---
import { siteConfig } from '../config/site';

const groups = [
  {
    title: 'AI product systems',
    items: [
      'LLM applications',
      'Multi-agent workflows',
      'Structured outputs',
      'RAG and embeddings',
      'Text-to-SQL',
      'LLM evaluation',
      'Agent protocols (MCP / AG-UI)',
    ],
  },
  {
    title: 'Product and backend delivery',
    items: [
      'Python',
      'FastAPI',
      'Pydantic',
      'Docker',
      'GCP Cloud Run',
      'Testing and CI',
      'Production observability',
    ],
  },
  {
    title: 'Applied machine learning',
    items: [
      'scikit-learn',
      'XGBoost',
      'Meta Prophet',
      'Anomaly detection',
      'NLP',
      'Model explainability',
    ],
  },
  {
    title: 'Data engineering and analytics',
    items: ['SQL', 'BigQuery', 'Redshift', 'Airflow', 'PySpark', 'ETL pipelines'],
  },
] as const;
---

<section
  class="section-block capabilities-section"
  id="skills"
  data-nav-section
  data-section-id="skills"
  aria-labelledby="skills-title"
  tabindex="-1"
>
  <div class="site-shell">
    <div class="capabilities-heading">
      <h2 class="section-title" id="skills-title">Skills</h2>
      <p class="section-intro">
        A practical stack for{' '}<span class="text-accent">shipping applied AI</span>. Technologies
        are selected around the product and its constraints. These are the areas most relevant to
        the work I deliver — not an exhaustive tool inventory.
      </p>
    </div>

    <div class="capability-groups">
      {
        groups.map((group, index) => (
          <section aria-labelledby={`capability-${index}`}>
            <span class="item-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 id={`capability-${index}`}>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="skills-documents" aria-label="Professional documents">
      <a
        class="button-link secondary"
        href={siteConfig.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
      >
        View{' '}<span class="text-accent">LinkedIn Profile</span>{' '}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <a
        class="button-link secondary"
        href="/documents/vanja-smailovic-cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        View{' '}<span class="text-accent">CV</span>{' '}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <a
        class="button-link secondary"
        href="/documents/vanja-smailovic-portfolio-d360efbf29b1.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        View{' '}<span class="text-accent">Portfolio</span>{' '}
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    background: var(--color-panel);
  }

  .capabilities-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: start;
    gap: 3rem;
  }

  .capabilities-heading .section-intro {
    margin: 0;
  }

  .capability-groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .capability-groups section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .item-number {
    display: block;
    margin-bottom: 1.4rem;
  }

  h3 {
    min-height: 5rem;
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(1.55rem, 2.8vw, 2.15rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }

  li {
    padding: 0.32rem 0.72rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel-strong);
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .skills-documents {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 60rem) {
    .capability-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .capabilities-heading {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }
  }

  @media (max-width: 34rem) {
    .capability-groups {
      grid-template-columns: 1fr;
    }

    h3 {
      min-height: auto;
    }

    .skills-documents,
    .skills-documents :global(.button-link) {
      width: 100%;
    }
  }
</style>
