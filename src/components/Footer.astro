---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer>
  <div class="site-shell footer-inner">
    <div class="footer-company">
      <strong>Vanja Solutions AB</strong>
      <span>Tumba, Greater Stockholm Area, Sweden</span>
      <span>Org.nr. 559585-8415</span>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
    <a
      class="linkedin-link"
      href={siteConfig.linkedIn}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Vanja Smailovic on LinkedIn (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V8.98H7.1v11.47Z"
        ></path>
      </svg>
    </a>
    <span class="footer-copyright">Vanja Smailovic © <span id="copyright-year">{year}</span></span>
  </div>
</footer>

<script>
  const copyrightYear = document.getElementById('copyright-year');
  if (copyrightYear) {
    copyrightYear.textContent = String(new Date().getFullYear());
  }
</script>
