---
const services = [
  {
    number: '01',
    title: 'AI assistants and analytics agents',
    description:
      'Conversational and multi-agent workflows that synthesize information, support decisions, and make domain analytics accessible through natural language.',
    capabilities: ['LLM assistants', 'Multi-agent workflows', 'Text-to-SQL', 'Tool calling'],
  },
  {
    number: '02',
    title: 'Document and knowledge automation',
    description:
      'Reliable pipelines that turn PDFs and business documents into validated structured data or grounded answers.',
    capabilities: ['Document extraction', 'Structured outputs', 'OCR and multimodal AI', 'RAG'],
  },
  {
    number: '03',
    title: 'Applied machine-learning products',
    description:
      'Customer-facing and operational ML capabilities for monitoring, risk, classification, prediction, and prioritization.',
    capabilities: ['Anomaly detection', 'Risk modeling', 'NLP classification', 'Regression'],
  },
  {
    number: '04',
    title: 'AI product discovery and delivery',
    description:
      'Pragmatic support from ambiguous opportunity to evaluated prototype, technical plan, MVP, and production capability.',
    capabilities: [
      'Product discovery',
      'Evaluation design',
      'Rapid prototyping',
      'Technical roadmap',
    ],
  },
] as const;
---

<section class="section-block" aria-labelledby="services-title">
  <div class="site-shell">
    <div class="section-heading-grid">
      <div>
        <p class="section-kicker">Services</p>
        <h2 class="section-title" id="services-title">
          From unclear opportunity to useful product.
        </h2>
      </div>
      <p class="section-intro">
        I work with product and engineering teams where AI needs to move beyond a demo — into a
        system that is grounded, evaluated, maintainable, and valuable to the people using it.
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <span class="service-number" aria-hidden="true">
              {service.number}
            </span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul aria-label={`${service.title} capabilities`}>
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-heading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: end;
    gap: 3rem;
  }

  .section-intro {
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border: 1px solid var(--color-line);
    background: var(--color-line);
  }

  .service-card {
    min-height: 23rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--color-panel);
    transition: background-color 160ms ease;
  }

  .service-card:hover {
    background: var(--color-panel-strong);
  }

  .service-number {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h3 {
    max-width: 18ch;
    margin: 3.5rem 0 0;
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  article > p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 2rem 0 0;
    list-style: none;
  }

  li {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-line);
    color: #c7d0d3;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 48rem) {
    .section-heading-grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }

    .section-intro {
      margin: 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 0;
    }

    h3 {
      margin-top: 2.5rem;
    }
  }
</style>
