---
const services = [
  {
    title: 'AI assistants and agents',
    description:
      'Conversational and multi-agent workflows that synthesize information, support decisions and make domain analytics accessible through natural language.',
    capabilities: ['LLM assistants', 'Multi-agent workflows', 'Text-to-SQL', 'Tool calling'],
  },
  {
    title: 'Document and knowledge automation',
    description:
      'Reliable pipelines that turn PDFs and business documents into validated structured data or grounded answers.',
    capabilities: ['Document extraction', 'Structured outputs', 'OCR and multimodal AI', 'RAG'],
  },
  {
    title: 'Applied machine-learning products',
    description:
      'Customer-facing and operational ML capabilities for monitoring, risk, classification, prediction and prioritization.',
    capabilities: ['Anomaly detection', 'Risk modeling', 'NLP classification', 'Regression'],
  },
  {
    title: 'AI product discovery and delivery',
    description:
      'Pragmatic support from ambiguous opportunity to evaluated prototype, technical plan, MVP and production capability.',
    capabilities: [
      'Product discovery',
      'Evaluation design',
      'Rapid prototyping',
      'Technical roadmap',
    ],
  },
] as const;
---

<section
  class="section-block"
  id="services"
  data-nav-section
  data-section-id="services"
  aria-labelledby="services-title"
  tabindex="-1"
>
  <div class="site-shell">
    <div class="section-heading-grid">
      <h2 class="section-title" id="services-title">Services</h2>
      <p class="section-intro">
        From unclear opportunity to useful product. I work with product and engineering teams where{
          ' '
        }
        <span class="text-accent">AI needs to move beyond a demo</span>{' '}— into a system that is
        grounded, evaluated, maintainable and valuable to the people using it.
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((service, index) => (
          <article class="service-card">
            <span class="item-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul aria-label={`${service.title} capabilities`}>
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-heading-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: start;
    gap: 3rem;
  }

  .section-intro {
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 8vw, 7rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .service-card {
    min-height: 18rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  .item-number {
    display: block;
    margin-bottom: 1.5rem;
  }

  h3 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(1.55rem, 2.8vw, 2.15rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  article > p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 2rem 0 0;
    list-style: none;
  }

  li {
    padding: 0.32rem 0.72rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-panel);
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  @media (max-width: 48rem) {
    .section-heading-grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }

    .section-intro {
      margin: 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 0;
    }
  }
</style>
