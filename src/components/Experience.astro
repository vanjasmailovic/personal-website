---
import { Image } from 'astro:assets';

import eqtLogo from '../assets/companies/eqt.jpg';
import ericssonLogo from '../assets/companies/ericsson.png';
import instantorLogo from '../assets/companies/instantor.jpg';
import pagosLogo from '../assets/companies/pagos.jpg';
import sandvikLogo from '../assets/companies/sandvik.jpg';
import tinkLogo from '../assets/companies/tink.jpg';

const experience = [
  {
    company: 'EQT',
    rolePrefix: null,
    role: ' via Northbridge',
    roleAccent: 'AI Engineering Consultant',
    period: '2026 — present',
    successfullyExited: false,
    logo: eqtLogo,
    treatment: 'invert',
  },
  {
    company: 'Pagos',
    rolePrefix: null,
    role: ' & Engineering Manager',
    roleAccent: 'Lead Data Scientist',
    period: '2023 — 2025',
    successfullyExited: false,
    logo: pagosLogo,
    treatment: 'invert',
  },
  {
    company: 'Tink',
    rolePrefix: null,
    role: 'Senior Data Scientist',
    roleAccent: null,
    period: '2020 — 2023',
    successfullyExited: true,
    logo: tinkLogo,
    treatment: 'invert',
  },
  {
    company: 'Instantor',
    rolePrefix: null,
    role: 'Senior Data Scientist',
    roleAccent: null,
    period: '2019 — 2020',
    successfullyExited: true,
    logo: instantorLogo,
    treatment: 'screen',
  },
  {
    company: 'Sandvik',
    rolePrefix: null,
    role: 'Data Scientist',
    roleAccent: null,
    period: '2017 — 2019',
    successfullyExited: false,
    logo: sandvikLogo,
    treatment: 'invert',
  },
  {
    company: 'Ericsson',
    rolePrefix: 'Research Engineer & ',
    role: '',
    roleAccent: 'PhD Candidate',
    period: '2011 — 2017',
    successfullyExited: false,
    logo: ericssonLogo,
    treatment: 'screen',
  },
] as const;
---

<section class="section-block experience-section" aria-labelledby="experience-title">
  <div class="site-shell">
    <div class="experience-heading">
      <h2 class="section-title" id="experience-title">Selected Experience</h2>
      <p class="section-intro">
        Product work across different operating realities. Startup urgency, scale-up growth and
        enterprise constraints require different choices. My work spans each — including{' '}
        <span class="text-accent">two successful acquisition journeys</span>{' '}from Instantor to
        Tink and Tink to Visa.
      </p>
    </div>

    <ol class="experience-list">
      {
        experience.map((item) => (
          <li>
            <div class="logo-wrap">
              <Image
                src={item.logo}
                alt={`${item.company} logo`}
                width={190}
                format="webp"
                loading="lazy"
                class:list={[
                  'company-logo',
                  `company-logo--${item.treatment}`,
                  `company-logo--${item.company.toLowerCase()}`,
                ]}
              />
            </div>
            <div class="experience-role">
              <div class="company-heading">
                <strong>{item.company}</strong>
                {item.successfullyExited && <span class="exit-pill">Successfully Exited</span>}
              </div>
              <span>
                {item.rolePrefix}
                {item.roleAccent && <span class="text-accent">{item.roleAccent}</span>}
                {item.role}
              </span>
            </div>
            <time>{item.period}</time>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience-section {
    background: var(--color-panel);
  }

  .experience-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: start;
    gap: 3rem;
  }

  .experience-heading .section-intro {
    margin: 0;
  }

  .experience-list {
    padding: 0;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .experience-list > li {
    display: grid;
    min-height: 8.5rem;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(15rem, 1.3fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  time {
    color: var(--color-muted);
    font-size: 0.78rem;
    letter-spacing: 0;
  }

  .logo-wrap {
    display: flex;
    width: 9.5rem;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .company-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.58;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .company-logo--invert {
    filter: grayscale(1) invert(1) contrast(1.15);
    mix-blend-mode: screen;
  }

  .company-logo--screen {
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: screen;
  }

  .company-logo--pagos {
    transform: scale(0.72);
  }

  .company-logo--tink {
    transform: scale(1.75);
  }

  .company-logo--instantor,
  .company-logo--sandvik {
    transform: scale(1.8);
  }

  .company-logo--ericsson {
    transform: scale(1.5);
  }

  li:hover .company-logo {
    opacity: 0.95;
  }

  .experience-role {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .experience-role strong {
    font-size: 1.05rem;
    font-weight: 650;
  }

  .company-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .exit-pill {
    padding: 0.24rem 0.62rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 999px;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .experience-role > span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  time {
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .experience-heading {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.75rem;
    }

    .experience-heading .section-intro {
      margin: 0;
    }

    .experience-list > li {
      grid-template-columns: minmax(7rem, 0.55fr) minmax(0, 1fr);
    }

    .experience-list > li > time {
      grid-column: 2;
    }
  }

  @media (max-width: 34rem) {
    .experience-list > li {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      padding-block: 1.75rem;
    }

    .experience-list > li > .logo-wrap,
    .experience-list > li > .experience-role,
    .experience-list > li > time {
      grid-column: 1;
    }

    .logo-wrap {
      width: 8.5rem;
      height: 3rem;
    }
  }
</style>
