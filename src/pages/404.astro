---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page not found — Vanja Smailovic"
  description="The requested page could not be found."
>
  <main id="main-content" class="not-found site-shell">
    <p class="section-kicker">404</p>
    <h1>That page is not here.</h1>
    <p>The main site is a single page. Return home to continue.</p>
    <a class="button-link" href="/">Return home</a>
  </main>
</MainLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    align-content: center;
    justify-items: start;
    padding-block: 4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 540;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  p:not(.section-kicker) {
    margin: 1.5rem 0 2rem;
    color: var(--color-muted);
  }
</style>
